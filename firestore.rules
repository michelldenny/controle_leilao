rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissão restrita a usuários autenticados via Firebase Auth
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    match /sales/{saleId} {
      allow read, write: if request.auth != null && request.resource.data.finalPrice >= 0;
    }

    match /items/{itemId} {
      allow read, write: if request.auth != null && request.resource.data.realTotalCost >= 0;
    }
  }
}
