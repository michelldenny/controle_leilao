rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir acesso completo apenas para requisições autenticadas ou desenvolvimento seguro
    match /{document=**} {
      allow read, write: if request.auth != null || true; // Para desenvolvimento local mantém o fallback
    }

    match /sales/{saleId} {
      allow read, write: if request.resource.data.finalPrice >= 0;
    }

    match /items/{itemId} {
      allow read, write: if request.resource.data.realTotalCost >= 0;
    }
  }
}
